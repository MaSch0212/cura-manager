<mct:DialogWindow
  x:Class="CuraManager.Views.EditProjectDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:CuraManager.Views"
  xmlns:m="http://schemas.masch212.de/MaSch/Wpf"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mct="http://schemas.masch212.de/MaSch/Wpf/Controls"
  Title="{m:Translation Title_EditProject}"
  Width="500"
  FocusManager.FocusedElement="{Binding ElementName=ProjectNameTextBox}"
  Maximizable="False"
  ResizeMode="NoResize"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d"
>
  <mct:Window.CustomIcon>
    <mct:IconPresenter Icon="{m:MaterialDesignIcon Pencil}" />
  </mct:Window.CustomIcon>
  <StackPanel Margin="10">
    <StackPanel.Resources>
      <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
        <Setter Property="Margin" Value="0,20,0,0" />
      </Style>
      <CollectionViewSource
        x:Key="Tags"
        Source="{Binding Tags, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}}"
      >
        <CollectionViewSource.SortDescriptions>
          <componentModel:SortDescription Direction="Ascending" PropertyName="Name" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
    </StackPanel.Resources>
    <Label Margin="0" Content="{m:Translation ProjectName}" />
    <TextBox
      x:Name="ProjectNameTextBox"
      KeyDown="InputTextBox_OnKeyDown"
      Text="{Binding ProjectName, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, UpdateSourceTrigger=PropertyChanged}"
    />
    <Label Content="{m:Translation ProjectUrl}" />
    <TextBox
      KeyDown="InputTextBox_OnKeyDown"
      Text="{Binding ProjectUrl, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, UpdateSourceTrigger=PropertyChanged}"
    />
    <Label Content="{m:Translation Tags}" />
    <mct:TextBox
      KeyDown="NewTagTextBox_OnKeyDown"
      Text="{Binding NewTagName, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, UpdateSourceTrigger=PropertyChanged}"
      ToolTip="{m:Translation CreateNewTag}"
    >
      <mct:TextBox.EndContent>
        <mct:IconButton
          Padding="8"
          Click="AddTagButton_OnClick"
          Icon="{m:MaterialDesignIcon Plus}"
          ToolTip="{m:Translation CreateNewTag}"
        />
      </mct:TextBox.EndContent>
    </mct:TextBox>
    <Border
      Margin="0,5,0,0"
      Padding="0,4"
      BorderBrush="{m:ThemeValue Key=NormalForegroundBrush}"
      BorderThickness="1"
    >
      <Grid>
        <TextBlock
          Margin="10,6"
          Opacity="0.5"
          Text="{m:Translation NoTagsAvailable}"
          TextWrapping="Wrap"
        >
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger
                  Binding="{Binding RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, Path=Tags.Count}"
                  Value="0"
                >
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ScrollViewer
          MaxHeight="180"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
        >
          <ItemsControl ItemsSource="{Binding Source={StaticResource Tags}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="10,4" Content="{Binding Name}" IsChecked="{Binding IsSet}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <CheckBox
      Margin="0,20,0,0"
      Content="{m:Translation Archived}"
      IsChecked="{Binding IsArchived, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}}"
    />
    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button
        MinWidth="100"
        Margin="0,0,10,0"
        Click="SaveButton_OnClick"
        Content="{m:Translation Save}"
      />
      <Button MinWidth="100" Click="CancelButton_OnClick" Content="{m:Translation Cancel}" />
    </StackPanel>
  </StackPanel>
</mct:DialogWindow>
