<mct:DialogWindow
  x:Class="CuraManager.Views.EditProjectDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:CuraManager.Views"
  xmlns:m="http://schemas.masch212.de/MaSch/Wpf"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mct="http://schemas.masch212.de/MaSch/Wpf/Controls"
  Title="{m:Translation Title_EditProject}"
  Width="500"
  FocusManager.FocusedElement="{Binding ElementName=ProjectNameTextBox}"
  Maximizable="False"
  ResizeMode="NoResize"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d"
>
  <mct:Window.CustomIcon>
    <mct:IconPresenter Icon="{m:MaterialDesignIcon Pencil}" />
  </mct:Window.CustomIcon>
  <StackPanel Margin="10">
    <StackPanel.Resources>
      <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
        <Setter Property="Margin" Value="0,20,0,0" />
      </Style>
      <CollectionViewSource
        x:Key="SelectedTags"
        Source="{Binding SelectedTags, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}}"
      >
        <CollectionViewSource.SortDescriptions>
          <componentModel:SortDescription Direction="Ascending" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
    </StackPanel.Resources>
    <Label Margin="0" Content="{m:Translation ProjectName}" />
    <TextBox
      x:Name="ProjectNameTextBox"
      KeyDown="InputTextBox_OnKeyDown"
      Text="{Binding ProjectName, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, UpdateSourceTrigger=PropertyChanged}"
    />
    <Label Content="{m:Translation ProjectUrl}" />
    <TextBox
      KeyDown="InputTextBox_OnKeyDown"
      Text="{Binding ProjectUrl, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, UpdateSourceTrigger=PropertyChanged}"
    />
    <Label Content="{m:Translation Tags}" />
    <DockPanel>
      <mct:IconButton
        Width="28"
        Height="28"
        Margin="5,0,0,0"
        Padding="6"
        Click="AddTagButton_OnClick"
        DockPanel.Dock="Right"
        Icon="{m:MaterialDesignIcon Plus}"
        ToolTip="{m:Translation AddTag}"
      />
      <mct:TextBox
        x:Name="TagInputTextBox"
        Description="{m:Translation AddTagDescription}"
        IsKeyboardFocusWithinChanged="TagInput_OnIsKeyboardFocusWithinChanged"
        PreviewKeyDown="TagInput_OnPreviewKeyDown"
        PreviewMouseLeftButtonUp="TagInput_OnPreviewMouseLeftButtonUp"
        Text="{Binding NewTagName, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, UpdateSourceTrigger=PropertyChanged}"
      />
    </DockPanel>
    <Popup
      x:Name="TagSuggestionsPopup"
      Width="{Binding ActualWidth, ElementName=TagInputTextBox}"
      Placement="Bottom"
      PlacementTarget="{Binding ElementName=TagInputTextBox}"
      StaysOpen="True"
    >
      <Border
        Background="{m:ThemeValue Key=NormalBackgroundBrush}"
        BorderBrush="{m:ThemeValue Key=NormalBorderBrush}"
        BorderThickness="1"
      >
        <ListBox
          x:Name="TagSuggestionsListBox"
          MaxHeight="160"
          Background="Transparent"
          BorderThickness="0"
          ItemsSource="{Binding TagSuggestions, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}}"
          PreviewMouseLeftButtonUp="TagSuggestions_OnPreviewMouseLeftButtonUp"
        >
          <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
              <!--  Keeps clicking a suggestion from pulling focus out of the input.  -->
              <Setter Property="Focusable" Value="False" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>
    </Popup>
    <TextBlock Margin="0,10,0,0" Opacity="0.5" Text="{m:Translation NoTagsAssigned}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger
              Binding="{Binding RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}, Path=SelectedTags.Count}"
              Value="0"
            >
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Source={StaticResource SelectedTags}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border
            Margin="0,0,6,6"
            Padding="10,2,3,2"
            BorderBrush="{m:ThemeValue Key=NormalBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
          >
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Text="{Binding}" />
              <mct:IconButton
                Width="18"
                Height="18"
                Margin="6,0,0,0"
                Padding="4"
                Click="RemoveTagButton_OnClick"
                CornerRadius="9"
                Icon="{m:MaterialDesignIcon Close}"
                ToolTip="{m:Translation RemoveTag}"
              />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <CheckBox
      Margin="0,20,0,0"
      Content="{m:Translation Archived}"
      IsChecked="{Binding IsArchived, RelativeSource={RelativeSource AncestorType=local:EditProjectDialog}}"
    />
    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button
        MinWidth="100"
        Margin="0,0,10,0"
        Click="SaveButton_OnClick"
        Content="{m:Translation Save}"
      />
      <Button MinWidth="100" Click="CancelButton_OnClick" Content="{m:Translation Cancel}" />
    </StackPanel>
  </StackPanel>
</mct:DialogWindow>
