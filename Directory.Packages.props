<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build and analysis -->
    <PackageVersion Include="CSharpier.MsBuild" Version="1.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400" />

    <!-- MaSch framework -->
    <PackageVersion Include="MaSch.Generators" Version="0.3.4" />
    <PackageVersion Include="MaSch.Native.Windows" Version="0.1.4" />
    <PackageVersion Include="MaSch.Presentation" Version="0.2.5" />
    <PackageVersion Include="MaSch.Presentation.Wpf.Controls" Version="0.2.9" />
    <PackageVersion Include="MaSch.Presentation.Wpf.MaterialDesign" Version="0.3.0" />
    <PackageVersion Include="MaSch.Presentation.Wpf.Themes" Version="0.2.1" />

    <!-- Application dependencies -->
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageVersion Include="ini-parser-netstandard" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Windows.Compatibility" Version="10.0.11" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
